# Required to run an agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# Optional: enables the web_search tool
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=3

# Upper bound on tool calls per task
MAX_TOOL_ITERATIONS=5

# Where state lives
AGENT_DB_PATH=agent_memory.db
CONTEXT_PERSIST_DIR=context_db
